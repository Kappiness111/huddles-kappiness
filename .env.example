# ─────────────────────────────────────────────────────────────────────────────────────
# FRONTEND: copy to .env.local (for `npm run dev` / `npm run build`).
# Everything is optional. With nothing set, the app still works end to end (live Google Books /
# Open Library + the bundled shelf) and is honest about what isn't connected.
# Anything prefixed VITE_ ships to the browser: NEVER put a secret here.
# ─────────────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API. The URL, plus the PUBLIC key: either the legacy "anon" key
# or the newer "publishable" key (sb_publishable_...). Never the service_role / secret key.
# Row-level security lets this key INSERT submissions only. It cannot read anything back.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# Turn on once the Edge Functions are deployed and their secrets are set.
VITE_EMAIL_ENABLED=false
VITE_TMDB_ENABLED=false

# Google Books public browser key. Restrict it by HTTP referrer in Google Cloud. Recommended.
VITE_GOOGLE_BOOKS_API_KEY=

# Advanced overrides (optional)
# VITE_TMDB_PROXY_URL=https://<project>.supabase.co/functions/v1/tmdb
# VITE_TMDB_READ_TOKEN=   # LOCAL TESTING ONLY. Exposes the token to the browser.

# ─────────────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS: do NOT put these in .env.local. They live only on Supabase:
#   supabase secrets set --env-file supabase/functions/.env
# (copy supabase/functions/.env.example to supabase/functions/.env; it is git-ignored)
#
#   RESEND_API_KEY   re_...                                   (Resend → API Keys)
#   RESEND_FROM      "Kappiness <stories@your-domain.com>"    (a domain verified in Resend)
#   SITE_URL         https://kappiness111.github.io/huddles-kappiness
#   ALLOWED_ORIGIN   https://kappiness111.github.io           (optional, CORS)
#   RESEND_REPLY_TO  hello@your-domain.com                    (optional)
#   TMDB_READ_TOKEN  TMDB "API Read Access Token"             (for the tmdb function)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
# ─────────────────────────────────────────────────────────────────────────────────────
