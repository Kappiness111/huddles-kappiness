# Copy to .env.local. Everything is optional — with nothing set the app still works end to end
# (live Google Books / Open Library + the bundled shelf) and is honest about what isn't connected.
# Anything prefixed VITE_ ships to the browser: NEVER put a secret here. Secrets go into
# Supabase Edge Function secrets (see README → Backend).

# Supabase project (the anon key is public; RLS allows INSERT only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Turn on once the Edge Functions are deployed
VITE_EMAIL_ENABLED=false
VITE_TMDB_ENABLED=false

# Google Books public browser key — restrict it by HTTP referrer in Google Cloud. Recommended.
VITE_GOOGLE_BOOKS_API_KEY=

# Advanced overrides (optional)
# VITE_EMAIL_ENDPOINT=https://<project>.supabase.co/functions/v1/send-recommendation-email
# VITE_TMDB_PROXY_URL=https://<project>.supabase.co/functions/v1/tmdb
# VITE_TMDB_READ_TOKEN=   # LOCAL TESTING ONLY — exposes the token to the browser
